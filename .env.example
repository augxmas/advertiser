# ============================================================
# 모노라마 광고 관리 시스템 - 환경변수 설정
# 이 파일을 복사하여 .env 로 저장 후 값을 채워주세요.
# cp .env.example .env
# ============================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campaign
DB_USER=advertiser
DB_PASSWORD=change_me_database_password
# ── Database ──────────────────────────────────────────────


SMTP_HOST=smtp.worksmobile.com
SMTP_PORT=465
SMTP_USER=your_smtp_account@example.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=(주)모노라마

# ── SMTP (이메일 발송) ────────────────────────────────────


# ── Session / 암호화 ──────────────────────────────────────
# 충분히 긴 무작위 문자열로 변경하세요 (최소 32자)
SESSION_SECRET=change_me_to_a_random_secret_string
# MariaDB fn_encrypt / fn_decrypt 함수의 AES 키
# schema.sql 의 SHA2() 인자와 반드시 일치해야 합니다.
ENCRYPT_KEY=change_me_to_a_random_encrypt_key

# ── Supervisor 계정 ───────────────────────────────────────
SUPERVISOR_USERNAME=supervisor
SUPERVISOR_PASSWORD=change_me_supervisor_password
SUPERVISOR_EMAIL=admin@example.com

# ── 회사 정보 (견적서/세금계산서 표기) ────────────────────
COMPANY_NAME=(주)모노라마
COMPANY_CEO=대표자명
COMPANY_BIZ_NO=000-00-00000
COMPANY_ADDRESS=회사 주소
COMPANY_BIZ_TYPE=서비스
COMPANY_BIZ_CATEGORY=컴퓨터 프로그램 개발 및 공급
COMPANY_BANK_NAME=은행명
COMPANY_BANK_ACCOUNT=0000-000-000000
TAX_MANAGER_EMAIL=tax@example.com

# ── 서버 ────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000

# ── 광고 요금 ────────────────────────────────────────────
AD_PRICE_PER_DAY=1000
VAT_RATE=0.1
